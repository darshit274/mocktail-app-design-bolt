{
  "expo": {
    "name": "MockTale Academy",
    "slug": "mocktale-academy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MockTale.jpg",
    "splash": {
      "image": "./assets/images/MockTale-splash-screen.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mocktale.mocktaleacademy",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.mocktale.mocktaleacademy",
      "versionCode": 9,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/MockTale.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "permissions": [],
            "buildFeatures": {
              "prefab": true
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb383c95-d1a3-4dd7-b655-a17543571c0e"
      }
    }
  }
}