{
  "expo": {
    "name": "MockTale Academy",
    "slug": "mocktale-academy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MockTale.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mocktale.mocktaleacademy",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.mocktale.mocktaleacademy",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/MockTale.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-camera",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "buildFeatures": {
              "prefab": true
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a383209-b22f-4851-a7a2-4fb240babbaa"
      }
    }
  }
}
